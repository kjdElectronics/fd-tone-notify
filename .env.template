FD_LOG_LEVEL=debug
FD_PUSHBULLET_API_KEY=

# Pushover: create an Application at https://pushover.net/apps/build to get an App Token.
# Each notification config also needs a Pushover User/Group Key (see README).
FD_PUSHOVER_APP_TOKEN=

# Telegram: message @BotFather on Telegram to create a bot and get its token.
# Each notification config also needs a chat id (see README).
FD_TELEGRAM_BOT_TOKEN=

FD_CORALOGIX_PRIVATE_KEY=
FD_CORALOGIX_APPLICATION_NAME=FD-Tone-Notify
FD_CORALOGIX_SUBSYSTEM_NAME=Test

FD_SMTP_USERNAME=apikey
FD_SMTP_PASSWORD=
FD_SMTP_TEST_TO=

FD_PORT=3000

# Set to true to disable live microphone capture (e.g. headless/API+Rdio-only
# deployments, or any host with no sound device). See docs/docker.md.
FD_AUDIO_DISABLED=false

# Recording Configuration
FD_RECORDING_DIRECTORY=./recordings
FD_AUTO_DELETE_RECORDINGS_OLDER_THAN_DAYS=7

# System-wide Detection Webhook (control-plane integration)
# Fires an HMAC-signed POST to this URL on every tone detection (mic, file, Rdio),
# independent of any per-detector notification configuration. See docs/api.md.
FD_DETECTION_WEBHOOK_URL=
FD_DETECTION_WEBHOOK_SECRET=